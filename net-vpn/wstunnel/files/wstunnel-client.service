[Unit]
Description=wstunnel client daemon
Requires=nss-lookup.target network.target
After=nss-lookup.target network.target

[Service]
Type=simple
ExecStart=/usr/libexec/wstunnel/wrapper client
Restart=always
RestartSec=5

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
